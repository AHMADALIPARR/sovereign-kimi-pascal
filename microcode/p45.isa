; P4.5 custom ISA
; register machine, explicit cluster, memory, butterfly and audit semantics
ISA P45.1
REGS 256
WARP 32
EXPERTS 896
ACTIVE 16
OP BF_XOR
OP BF_ADD
OP BF_REDUCE
OP GATE
OP DELTA
OP RECUR
OP ROUTE
OP TMA_LOAD
OP TMA_STORE
OP DSM_LOAD
OP DSM_STORE
OP CTX_SAVE
OP CTX_RESTORE
OP IRQ
OP LOCK
OP SEAL
OP FABRIC_SEND
OP FABRIC_RECV
OP FABRIC_REDUCE
OP CACHE_FREEZE
; P45 rule 001: explicit operand width, dependency edge, and verification boundary.
RULE 001 CHECK REGISTER_BOUNDS
